# Porta do servidor
PORT=3000
# Endereço público do app (usado no link dos e-mails)
APP_URL=https://enseada.seudominio.com.br
# Caminho do banco SQLite (precisa ficar em disco persistente)
DB_PATH=./data/enseada.db

# Primeiro administrador (usado só quando o banco está vazio)
ADMIN_EMAIL=sindico@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha

# E-mail (SMTP). Sem isso, os e-mails só aparecem no log do servidor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Condomínio Enseada <nao-responda@seudominio.com.br>"

# Notificações push (opcional: se vazio, as chaves são geradas e salvas no banco)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sindico@seudominio.com.br
